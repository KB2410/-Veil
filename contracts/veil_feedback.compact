pragma language_version 0.23;

import CompactStandardLibrary;

/**
 * ============================================================================
 * PRIVACY MODEL & ZERO-KNOWLEDGE SPECIFICATION: VEIL FEEDBACK
 * ============================================================================
 *
 * 1. PUBLIC LEDGER STATE (on-chain, verifiable by all observers):
 *    - `organizer`: Public commitment hash of the organizer/deployer.
 *    - `surveyOpen`: Boolean status flag indicating if the survey accepts submissions.
 *    - `eligibleCommitments`: Merkle / Set accumulator of blinded membership commitments.
 *    - `usedNullifiers`: Set of deterministic nullifiers enforcing one-response-per-member.
 *    - `ratingOne` ... `ratingFive`: Aggregate public counters for 1 to 5 star ratings.
 *
 * 2. PRIVATE WITNESS STATE (client-side only, never leaves user's local runtime):
 *    - `localSecret()`: Private key / entropy of the organizer or voter.
 *    - `credential()`: Private membership secret of the survey respondent.
 *    - `rating`: Private numerical score (1-5) submitted by the respondent.
 *
 * 3. SELECTIVE DISCLOSURE & PROOFS:
 *    - `credentialCommitment`: Blinded hash proving set membership without disclosing identity.
 *    - `surveyNullifier`: Scoped nullifier preventing Sybil/double submission.
 *    - `disclose(rating)`: Disclosed only within circuit execution to increment the corresponding
 *      aggregate public counter without linking back to respondent identity.
 * ============================================================================
 */

export sealed ledger organizer: Bytes<32>;
export ledger surveyOpen: Boolean;
export ledger eligibleCommitments: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger ratingOne: Counter;
export ledger ratingTwo: Counter;
export ledger ratingThree: Counter;
export ledger ratingFour: Counter;
export ledger ratingFive: Counter;

witness localSecret(): Bytes<32>;
witness credential(): Bytes<32>;

constructor() {
  organizer = disclose(dappPublicKey(localSecret()));
  surveyOpen = true;
}

// The issuer registers a one-way commitment, not a wallet address or identity.
export circuit addEligible(commitment: Bytes<32>): [] {
  assert(dappPublicKey(localSecret()) == organizer, "Only the issuer can add credentials");
  assert(!eligibleCommitments.member(disclose(commitment)), "Credential is already eligible");
  eligibleCommitments.insert(disclose(commitment));
}

// Demo issuer flow: derive and register a participant's commitment inside the
// circuit. Only the commitment is persisted; the credential remains a witness.
// The nonce is a harmless public call input. Keeping a concrete input avoids
// empty-input proving incompatibilities in some DApp Connector wallets; the
// credential itself remains a private witness.
export circuit addEligibleCredential(nonce: Uint<16>): [] {
  assert(dappPublicKey(localSecret()) == organizer, "Only the issuer can add credentials");
  assert(nonce < 65536, "Invalid registration nonce");
  const commitment = disclose(credentialCommitment(credential()));
  assert(!eligibleCommitments.member(commitment), "Credential is already eligible");
  eligibleCommitments.insert(commitment);
}

export circuit closeSurvey(): [] {
  assert(dappPublicKey(localSecret()) == organizer, "Only the issuer can close the survey");
  surveyOpen = false;
}

// Rating is a private witness. The one chosen aggregate counter changes as a proof effect.
export circuit submit(rating: Uint<16>): [] {
  const secret = credential();
  const commitment = disclose(credentialCommitment(secret));
  const nullifier = disclose(surveyNullifier(secret));
  const disclosedRating = disclose(rating);

  assert(surveyOpen, "Survey is closed");
  assert(eligibleCommitments.member(commitment), "Credential is not eligible");
  assert(!usedNullifiers.member(nullifier), "Credential has already responded");
  assert(disclosedRating > 0 && disclosedRating < 6, "Rating must be between one and five");

  usedNullifiers.insert(nullifier);
  if (disclosedRating == 1) { ratingOne.increment(1); }
  if (disclosedRating == 2) { ratingTwo.increment(1); }
  if (disclosedRating == 3) { ratingThree.increment(1); }
  if (disclosedRating == 4) { ratingFour.increment(1); }
  if (disclosedRating == 5) { ratingFive.increment(1); }
}

export circuit getTallies(): Vector<5, Uint<64>> {
  return [ratingOne, ratingTwo, ratingThree, ratingFour, ratingFive];
}

circuit dappPublicKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veil-feedback:issuer:"), secret]);
}

circuit credentialCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veil-feedback:member:"), secret]);
}

circuit surveyNullifier(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veil-feedback:nullifier:v1:"), secret]);
}
